# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PROKERALA_CLIENT_ID & PROKERALA_CLIENT_SECRET: Credentials for your external ProKerala Astrology API
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=


# Supabase API Credentials
# VITE_* são usadas pelo frontend/build do Vite.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# As variáveis abaixo são obrigatórias no backend (Vercel/Cloud Run):
# SUPABASE_URL pode ser igual a VITE_SUPABASE_URL.
# SUPABASE_SERVICE_ROLE_KEY é a chave de serviço (service_role), não a anon.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud Text-to-Speech
GOOGLE_CLOUD_PROJECT=
GOOGLE_TTS_CREDENTIALS_JSON=

# Resend (e-mails do painel admin)
RESEND_API_KEY=
VITE_MAIL_FROM=onboarding@resend.dev

# Application base URL (used for redirects and webhooks)
APP_URL=http://localhost:3000
VITE_APP_URL=http://localhost:3000

# InfinitePay merchant handle (InfiniteTag, without the $ symbol)
INFINITEPAY_HANDLE=

# Public webhook URL for InfinitePay (fill when using ngrok/localtunnel)
INFINITE_WEBHOOK_URL=

# Secret token to validate InfinitePay webhooks (append ?token=<value> in webhook_url)
INFINITE_WEBHOOK_SECRET=

# Monthly maintenance subscription link (InfinitePay Plans & Recurring)
INFINITE_PAY_MONTHLY_URL=
VITE_INFINITE_PAY_MONTHLY_URL=
INFINITE_PAY_MONTHLY_AMOUNT=1290

# Nakshatra PDF unlock key (sent via Manychat)
VITE_NAKSHATRA_PDF_KEY=LUZDOSOL
